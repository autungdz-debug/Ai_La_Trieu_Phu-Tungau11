<Window x:Class="AiLaTrieuPhu.Views.HighScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Vàng Triệu Phú" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="16" Background="{StaticResource StudioBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#FFB703" Opacity="0.5" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🏆 BẢNG VÀNG TRIỆU PHÚ"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Top 10 kỷ lục gia xuất sắc nhất chương trình"
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Scores List -->
            <DataGrid Grid.Row="1" x:Name="dgScores" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#0D1B2A" AlternatingRowBackground="#132338"
                      Foreground="White" FontSize="14" CanUserSortColumns="False" SelectionChanged="dgScores_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1B263B"/>
                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Họ tên người chơi" Binding="{Binding PlayerName}" Width="*"/>
                    <DataGridTextColumn Header="Tiền thưởng" Binding="{Binding PrizeFormatted}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số câu" Binding="{Binding QuestionsAnswered}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ngày lập" Binding="{Binding DateFormatted}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="ĐÓNG" Click="BtnClose_Click"
                    Style="{StaticResource PrimaryGoldButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Width="160" Height="40" />
        </Grid>
    </Border>
</Window>